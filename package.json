{
  "name": "rift-plugin-ayu",
  "homepage": "https://riftlabs.app",
  "author": "Rift Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/euforicio/rift-plugin-ayu.git"
  },
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "rift": ">=0.38",
    "riftPluginSdk": ">=0.4.48"
  },
  "scripts": {
    "generate": "node scripts/generate-themes.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "rift": {
    "name": "Ayu",
    "description": "The three ayu themes — Light, Dark, Mirage — with a palette explorer panel and a `bb ayu` colour lookup.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "id": "ayu-light",
        "name": "Ayu Light",
        "description": "Warm off-white, amber accent",
        "css": "./themes/ayu-light.css"
      },
      {
        "id": "ayu-dark",
        "name": "Ayu Dark",
        "description": "Deep near-black, amber accent",
        "css": "./themes/ayu-dark.css"
      },
      {
        "id": "ayu-mirage",
        "name": "Ayu Mirage",
        "description": "Muted blue-grey, warm amber accent",
        "css": "./themes/ayu-mirage.css"
      }
    ],
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "ayu": "9.1.0-beta.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "playwright": "^1.62.1",
    "sugar-high": "^1.2.1",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "zod": "^4.3.6",
    "@riftlabs/plugin-sdk": "0.4.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "sonner": "^1.7.4",
    "vaul": "^1.1.2"
  }
}
