{
  "name": "bb-plugin-ayu",
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "scripts": {
    "generate": "node scripts/generate-themes.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bb": {
    "name": "Ayu",
    "description": "The three ayu themes — Light, Dark, Mirage — with a palette explorer panel and a `bb ayu` colour lookup.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "id": "ayu-light",
        "name": "Ayu Light",
        "description": "Warm off-white, amber accent",
        "css": "./themes/ayu-light.css"
      },
      {
        "id": "ayu-dark",
        "name": "Ayu Dark",
        "description": "Deep near-black, amber accent",
        "css": "./themes/ayu-dark.css"
      },
      {
        "id": "ayu-mirage",
        "name": "Ayu Mirage",
        "description": "Muted blue-grey, warm amber accent",
        "css": "./themes/ayu-mirage.css"
      }
    ],
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "ayu": "9.1.0-beta.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "playwright": "^1.62.1",
    "sonner": "^2.0.7",
    "sugar-high": "^1.2.1",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  }
}
